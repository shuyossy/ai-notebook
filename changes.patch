+        expect(
+          mockIndividualDocumentReviewAgent.generateLegacy,
+        ).toHaveBeenCalledTimes(5);
+        // 統合レビューも呼ばれること
+        expect(mockConsolidateReviewAgent.generateLegacy).toHaveBeenCalled();
+      });
+    });
