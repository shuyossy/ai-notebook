+        '  Endpoints reference shapes (e.g., shape_1) or cell positions (e.g., A3).',
+        '  Arrow notation: -> (one-way), <- (reverse), <-> (bidirectional), -- (no arrow).',
+      );
+      return xlsxLines.join('\n');
