// SBOM の metadata.component.name を指定値に書き換える
// 使い方: node set-sbom-name.mjs <SBOMファイル> <名前>
import { readFileSync, writeFileSync } from "node:fs";

const [file, name] = process.argv.slice(2);
if (!file || !name) {
  console.error("使い方: node set-sbom-name.mjs <SBOMファイル> <名前>");
  process.exit(1);
}
const bom = JSON.parse(readFileSync(file, "utf-8"));
bom.metadata ??= {};
// metadata.component が無い場合(Gradle 失敗時など)は新しく作る
bom.metadata.component ??= { type: "application", "bom-ref": `application:${name}` };
bom.metadata.component.name = name;
writeFileSync(file, `${JSON.stringify(bom, null, 2)}\n`);
