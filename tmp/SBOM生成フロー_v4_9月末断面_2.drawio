                    </mxGeometry>
                </mxCell>
                <mxCell id="notes" value="&lt;b&gt;【検討事項一覧】&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. SBOM格納場所の決定:&lt;/b&gt; GitLab or Nexusのどちらにするか。併せて格納方式・ディレクトリ/ファイル命名ルールを決定(全件ループスキャンの実現可否に直結)。&lt;br&gt;&lt;b&gt;2. 改ざん防止・権限設計:&lt;/b&gt; 格納先決定後に具体化。Nexus案: 一般ユーザは閲覧/DLのみ・アップロードはCIサービスアカウント限定・再デプロイ禁止推奨 / GitLab案: プロジェクト権限・保護ブランチ等で同等の統制を設計。&lt;br&gt;&lt;b&gt;3. リリース断面とSBOMのズレ対策:&lt;/b&gt; 複数断面のSBOMを格納し全断面をスキャン / SBOMにリリース予定日を付与しスキャン対象を判定 / ズレを許容、のいずれかを決定。&lt;br&gt;&lt;b&gt;4. スキャン対象の指定方式:&lt;/b&gt; 実行時環境変数による手動指定と、格納ルールに基づく全件ループスキャンの使い分け(定期実行時は全件ループを想定)。&lt;br&gt;&lt;b&gt;5. スキャン運用の詳細:&lt;/b&gt; 定期実行の頻度、スキャン結果(artifact)の確認者・開発部への通知/連携方法、検知後のトリアージ基準。&lt;br&gt;&lt;b&gt;6. ServiceNow連携(10月以降):&lt;/b&gt; アップロード方式(手動 / API経由)の選定、行内NWからインターネット上のServiceNowへの接続経路・許可の確認、受入可能なCycloneDXバージョンの確認、登録運用の設計。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8EA9DB;align=left;verticalAlign=top;spacing=10;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1150" width="1170" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="2" value="&lt;b&gt;MUIT用の開発段階チェックは別途SBOM生成&amp;amp;trivyチェックのパイプラインテンプレートを提供する。trivyチェックが失敗したらパイプラインを失敗とする&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;strokeWidth=2;dashed=1;fontSize=10;fontColor=#1F4E79;align=left;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="170" y="175" width="210" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="3" style="endArrow=none;dashed=1;html=1;strokeColor=#2E75B6;strokeWidth=2;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.607;entryY=0.156;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" target="devproj">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="280" y="265" as="sourcePoint"/>
                        <mxPoint x="230" y="337" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>