                <mxCell id="eCopy2" value="&lt;span style=&quot;color: rgb(119, 119, 119);&quot;&gt;RoutingRule更新+資源凍結(開発NW内のサーバから実行)+資源コピー(特オペ)&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;strokeWidth=2;dashed=1;fontSize=9;fontColor=#777777;labelBackgroundColor=#FFFFFF;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="proxyNexus" target="prodNexus" edge="1">
