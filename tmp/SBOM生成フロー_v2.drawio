                            <mxPoint x="205" y="610"/>
                            <mxPoint x="378" y="610"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="eB2M" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" parent="1" source="genB" target="merge" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eNexusStore" value="&lt;b&gt;⑥ SBOMをNexusへ保存&lt;/b&gt;&#xa;(サイバー部アカウントでアップロード)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D6B656;strokeWidth=3;fontSize=11;fontColor=#7F6000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" parent="1" source="merge" edge="1">
                    <mxGeometry relative="1" as="geometry">
