                <mxCell id="eTrigger" value="&lt;b&gt;② Downstream Pipeline / Trigger API で呼び出し&lt;/b&gt;&#xa;(プロジェクト・ブランチ等の呼び出し情報を連携)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=3;fontSize=11;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.24;entryY=0;entryDx=0;entryDy=0;" parent="1" source="ci" target="cybproj" edge="1">
