                <mxCell id="nexusCallout" value="&lt;b&gt;◆ 改ざん防止(Nexus) ◆&lt;/b&gt;&lt;br&gt;SBOM格納用リポジトリの権限制御&lt;br&gt;・一般ユーザ: 閲覧/DLのみ(browse, read)&lt;br&gt;・サイバー部アカウント: アップロード可(add)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;dashed=1;fontSize=11;fontColor=#B85450;" parent="1" vertex="1">
                    <mxGeometry x="840" y="90" width="260" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="nexusCalloutLine" style="endArrow=none;dashed=1;html=1;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="nexusCallout" target="nexus" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="nexus" value="&lt;b&gt;Nexus&lt;/b&gt;&lt;br&gt;・ビルド成果物 / コンテナイメージ格納&lt;br&gt;・&lt;b&gt;SBOM格納用リポジトリ(hosted)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="840" y="260" width="260" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="snow" value="&lt;b&gt;ServiceNow&lt;/b&gt;&#xa;(SBOMの保管・管理)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="840" y="630" width="260" height="90" as="geometry"/>
