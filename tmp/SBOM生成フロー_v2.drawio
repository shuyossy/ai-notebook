                            <mxPoint x="810" y="654"/>
                            <mxPoint x="810" y="350"/>
                            <mxPoint x="840" y="350"/>
                        </Array>
                        <mxPoint x="840" y="350" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="eSnowFromNexus" value="&lt;b&gt;⑦ NexusからSBOMを取得してアップロード(手動 / API)&lt;/b&gt;&#xa;※一般ユーザでも閲覧・DL可のため&#xa;実施主体は開発部・サイバー部いずれでも可" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;strokeWidth=3;fontSize=11;fontColor=#5C3D73;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="nexus" target="snow" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eSnowRef" value="(参考) GitLab Artifactからの直接取得は&#xa;サイバー部PJへのReporter権限付与が必要となるため非推奨" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;strokeWidth=2;dashed=1;fontSize=10;fontColor=#777777;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="merge" target="snow" edge="1">
                    <mxGeometry x="-0.0747" y="-14" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="700" y="686"/>
                            <mxPoint x="700" y="675"/>
                        </Array>
                        <mxPoint x="-14" y="14" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="notes" value="&lt;b&gt;【補足説明】&lt;/b&gt;&#xa;・&lt;b&gt;改ざん防止(GitLab):&lt;/b&gt; サイバー部のSBOM生成用プロジェクトは開発部に編集権限を付与しない(パイプラインの実行権限のみ付与)。SBOMの完全性は管理主体であるサイバー部が担保する。&#xa;・&lt;b&gt;改ざん防止(Nexus):&lt;/b&gt; SBOM格納用リポジトリ(hosted)は一般ユーザに閲覧・ダウンロード(browse / read)のみ許可し、アップロード(add)はサイバー部アカウント(CIサービスアカウント)に限定する。再デプロイ(同一パスへの上書き)禁止の設定を推奨。&#xa;・&lt;b&gt;保存と登録:&lt;/b&gt; 生成・マージしたSBOMはCIからNexusへ保存(⑥)。ServiceNowへの登録(⑦)はNexusから取得して実施する(手動 / API)。一般ユーザでも閲覧・ダウンロード可能なため、登録主体は開発部・サイバー部のいずれでも権限付与なしで対応できる。&#xa;・&lt;b&gt;GitLab Artifactを配布経路にしない理由:&lt;/b&gt; プライベートプロジェクトのジョブアーティファクトのダウンロードには最低Reporterロールが必要となり、開発部への権限付与・棚卸しの管理負担が生じるうえ、CI設定等も閲覧可能になる。またArtifactには保持期限(expire_in)があるため、恒久的な保管・配布はNexusに一本化する。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8EA9DB;align=left;verticalAlign=top;spacing=10;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="790" width="1060" height="170" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>