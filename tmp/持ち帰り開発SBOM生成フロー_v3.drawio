<mxfile host="65bd71144e">
    <diagram id="mochikaeri-sbom-flow-v3" name="持ち帰り開発SBOM生成フロー">
        <mxGraphModel dx="989" dy="673" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1330" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;持ち帰り開発におけるSBOM生成レベルと判定フロー(9月末時点)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1F3864;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="900" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="&lt;b&gt;9月末については、なるべく上位レベルとなるように調整&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="50" width="1300" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="start" value="&lt;b&gt;判定開始&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="190" y="90" width="260" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="q1" value="&lt;b&gt;Q2&lt;/b&gt;&amp;nbsp;ソースコード全量を行内に持ち込み、&lt;div&gt;行内でビルドすることは可能か&lt;br&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="180" y="300" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="q2" value="&lt;b&gt;Q1&lt;/b&gt;&amp;nbsp;ビルドツール移行依頼&lt;br&gt;に準拠しているか？&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;= cdxgen適用可能な構成&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="180" y="165" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="q3" value="&lt;b&gt;Q3&lt;/b&gt; ロックファイルを&#xa;行内に持ち込めるか？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="180" y="420" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="q4" value="&lt;b&gt;Q4&lt;/b&gt; ベンダーが外部ビルド環境にてcdxgenで&lt;br&gt;SBOMを生成・納品できるか？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="180" y="580" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="q5" value="&lt;b&gt;Q5&lt;/b&gt;&amp;nbsp;依存関係定義ファイル(pom.xml等)&lt;br&gt;等を行内に持ち込んでcdxgenでSBOM生成できるか？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="180" y="720" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="lv1" value="&lt;b&gt;【Lv4】本番環境で稼働しているビルド成果物が利用しているライブラリを完全にトレース&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="305" width="480" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="lv2" value="&lt;b&gt;【Lv3】本番環境で稼働しているビルド成果物が利用しているライブラリを限りなくトレース&lt;/b&gt;&lt;br&gt;ロックファイル（ビルド成果物が利用している推移的依存含むライブラリのバージョンが固定で一覧化されている）を利用すればビルド成果物の依存関係を忠実にトレースできるものの、&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;ロックファイル改ざんの可能性は捨てきれないためLvは下がる&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="425" width="480" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="lv4" value="&lt;b&gt;【Lv2】&lt;/b&gt;&lt;b style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;行内で再解決した「推定」の依存ライブラリをトレースしている(実ビルドと乖離しうる)&lt;/b&gt;&lt;br&gt;pom.xml等から行内で依存解決して生成(乖離リスク残存)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="725" width="480" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="lv6" value="&lt;b&gt;【Lv1】トレース精度が完全にベンダーに依存する&lt;/b&gt;&lt;br&gt;恐らく、ベンダーが手動で作成するしかないため精度は完全にベンダー依存" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="640" y="850" width="480" height="70" as="geometry"/>
                </mxCell>
