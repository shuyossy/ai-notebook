                    </mxGeometry>
                </mxCell>
                <mxCell id="3" value="ここがNoの場合、納品されたビルド成果物からSBOMを生成し、補完情報として利用する案もアリ（9月末以降スコープ。成果物の形式によってはLv4のSBOMを生成できる可能性もある）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" vertex="1" parent="1">
                    <mxGeometry x="530" y="176" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="&lt;b&gt;【Lv3】本番環境で稼働しているビルド成果物が利用しているライブラリを限りなくトレース&lt;/b&gt;&lt;div&gt;外部でcdxgenを利用していること以外は行内のSBOM生成ロジックと変わらない&lt;/div&gt;&lt;div&gt;最終的に納品されるSBOMの改ざんの可能性は捨てきれないためLvは下がる&lt;/div&gt;&lt;div&gt;(行内のSBOM生成要件に合わせてcdxgenを利用してもらう必要がある)&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="640" y="585" width="480" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;fillColor=#b1ddf0;strokeColor=#10739e;entryX=0.024;entryY=0.353;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" target="6">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="320" y="510" as="sourcePoint"/>
                        <mxPoint x="420" y="520" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="6" value="ロックファイルが手元にあれば行内のSBOM生成要件（SBOMフォーマットやバージョン）に合わせて柔軟にSBOMを再生成したりできるので、まずはロックファイルを持ち込めるか確認する" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" vertex="1" parent="1">
                    <mxGeometry x="440" y="485" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="&lt;b&gt;No&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" target="q3">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="320" y="380" as="sourcePoint"/>
                        <mxPoint x="330" y="310" as="targetPoint"/>
                        <Array as="points">
                            <mxPoint x="320" y="390"/>
                            <mxPoint x="320" y="390"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="q2">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="330" y="390" as="sourcePoint"/>
                        <mxPoint x="330" y="430" as="targetPoint"/>
                        <Array as="points">
                            <mxPoint x="320" y="150"/>
                            <mxPoint x="320" y="150"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="15" value="&lt;b&gt;Yes&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;strokeWidth=2;fontSize=11;fontColor=#1F5C3F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q4" target="4">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="470" y="470" as="sourcePoint"/>
                        <mxPoint x="650" y="470" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="17" value="外部ベンダー独自にSBOMを生成し、納品するよう依頼する" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="215" y="840" width="210" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="&lt;b&gt;SBOM集中討議にて、持ち帰り開発についての精度は割り切りで合意済み（できるだけ高い精度でSBOMを生成する&lt;/b&gt;&lt;b style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;）により、9月末時点でのレベルの下限等は設けない。&lt;/b&gt;&lt;div&gt;&lt;div&gt;&lt;b&gt;ただし、原理的には高レベルである必要があるため。将来的にはレベルの下限を設定するか検討&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8EA9DB;align=left;verticalAlign=top;spacing=10;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="510" y="48" width="470" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="ビルドツール移行が強制である場合はこの矢印を削除" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" vertex="1" parent="1">
                    <mxGeometry x="30" y="950" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;fillColor=#b1ddf0;strokeColor=#10739e;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" target="24">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="120" y="890" as="sourcePoint"/>
                        <mxPoint x="240" y="1020" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="26" value="&lt;b&gt;No&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q5" target="17">
