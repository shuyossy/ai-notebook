                    </mxGeometry>
                </mxCell>
                <mxCell id="28" value="外部ベンダーがcdxgenを利用できない場合は、行内のSBOM生成要件を満たし、精度が悪化しないのであれば他ツールでも可" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" vertex="1" parent="1">
